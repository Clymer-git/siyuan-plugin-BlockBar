{
  "name": "siyuan-plugin-blockbar",
  "version": "0.1.0",
  "description": "Customizable quick toolbar docked above the SiYuan mobile keyboard toolbar (https://b3log.org/siyuan)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "pack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/engine/mobile-toolbar.ts --bundle --format=cjs --outfile=test/.engine.cjs --log-level=warning && node test/smoke.cjs"
  },
  "keywords": [
    "siyuan",
    "mobile",
    "toolbar",
    "keyboard"
  ],
  "author": "Clymer-git",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "esbuild-loader": "^4.3.0",
    "jsdom": "^30.1.3",
    "mini-css-extract-plugin": "^2.9.2",
    "siyuan": "1.2.8",
    "typescript": "^5.6.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "zip-webpack-plugin": "^4.0.3"
  }
}
